    "@types/node": "^26.6.5",
    "@types/sortablejs": "^1.15.9",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
